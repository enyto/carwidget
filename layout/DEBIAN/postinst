#!/bin/sh
set -e

BUNDLE=""

# Airaw runs as mobile and loads the Control bundle at user level.
for prefix in "/" "/var/jb/"; do
    candidate="${prefix}Library/Airaw/Widgets/Controls/AxsCarWidget.bundle"
    if [ -d "$candidate" ]; then
        BUNDLE="$candidate"
        chown -R mobile:mobile "$candidate" 2>/dev/null || true
    fi
done

# Older builds shipped a nested Prefs bundle and a ModuleInfo.plist. Airaw only instantiates
# modules shaped exactly like its own (four files), so leftovers are removed on upgrade.
if [ -n "$BUNDLE" ]; then
    rm -rf "$BUNDLE/Prefs" "$BUNDLE/ModuleInfo.plist"
fi

# Airaw refreshes widgets when it is reopened; no process is killed here.
exit 0
