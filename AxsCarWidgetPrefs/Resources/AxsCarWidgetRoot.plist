<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key><string>时间天气</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>时间显示</string>
            <key>footerText</key><string>使用 NSDateFormatter 格式。例如 HH:mm 为 24 小时制，h:mm 为 12 小时制；在 h:mm 中添加 a 可显示上午/下午。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>label</key><string>时间格式</string>
            <key>key</key><string>timeFormat</string>
            <key>defaults</key><string>com.axs.carwidget</string>
            <key>default</key><string>HH:mm</string>
            <key>placeholder</key><string>HH:mm</string>
            <key>autoCaps</key><string>None</string>
            <key>autoCorrection</key><string>None</string>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>label</key><string>日期格式</string>
            <key>key</key><string>dateFormat</string>
            <key>defaults</key><string>com.axs.carwidget</string>
            <key>default</key><string>M月d日 EEE</string>
            <key>placeholder</key><string>M月d日 EEE</string>
            <key>autoCaps</key><string>None</string>
            <key>autoCorrection</key><string>None</string>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>天气</string>
            <key>footerText</key><string>天气由 Open-Meteo 提供（无需 API key），每 20 分钟刷新一次。默认使用定位；拒绝定位或定位超时会改用下方城市。城市名只在手机上做地理编码，不会上传。</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>自动定位</string>
            <key>key</key><string>weatherAutoLocation</string>
            <key>defaults</key><string>com.axs.carwidget</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSEditTextCell</string>
            <key>label</key><string>天气城市</string>
            <key>key</key><string>weatherCityInput</string>
            <key>defaults</key><string>com.axs.carwidget</string>
            <key>default</key><string>上海</string>
            <key>placeholder</key><string>上海</string>
            <key>autoCaps</key><string>None</string>
            <key>autoCorrection</key><string>None</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>显示天气</string>
            <key>key</key><string>showWeather</string>
            <key>defaults</key><string>com.axs.carwidget</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>显示今日最高/最低</string>
            <key>key</key><string>showForecast</string>
            <key>defaults</key><string>com.axs.carwidget</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>显示翻页提示</string>
            <key>key</key><string>showPage</string>
            <key>defaults</key><string>com.axs.carwidget</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSTitleValueCell</string>
            <key>cellClass</key><string>AxsCarWidgetStepperCell</string>
            <key>label</key><string>天气刷新间隔（秒）</string>
            <key>key</key><string>stateRefreshInterval</string>
            <key>defaults</key><string>com.axs.carwidget</string>
            <key>default</key><real>60</real>
            <key>min</key><real>10</real>
            <key>max</key><real>600</real>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>说明</string>
            <key>footerText</key><string>在 Airaw 中修改后需点“立即应用修改”或重新连接 CarPlay。组件以 200×200 添加到桌面，可在 Airaw 中调整大小。</string>
        </dict>
    </array>
</dict>
</plist>
